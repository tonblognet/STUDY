# PostgreSQL (local Docker defaults)
DATABASE_URL="postgresql://postupai:postupai@localhost:5432/postupai?schema=public"

# Authentication. Generate long random values; never commit the real values.
AUTH_SECRET="replace-with-at-least-32-random-characters"
APP_URL="http://localhost:3000"
SESSION_COOKIE_NAME="postupai_session"
EMAIL_FROM="Поступай <noreply@example.ru>"
SMTP_URL="smtp://user:password@localhost:1025"

# Payments remain disabled until the merchant account, fiscalization and durable
# webhook processing have been verified. Never commit real terminal credentials.
PAYMENT_PROVIDER="disabled"
PAYMENTS_LIVE="false"
TBANK_TERMINAL_KEY=""
TBANK_PASSWORD=""
TBANK_API_URL="https://securepay.tinkoff.ru/v2"
TBANK_NOTIFICATION_URL="https://your-domain.example/api/webhooks/payments"
TBANK_FISCALIZATION_READY="false"

# Public product configuration.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_YANDEX_METRICA_ID=""
ANALYTICS_ENABLED="false"
SENTRY_DSN=""

# Background jobs and object storage
REDIS_URL="redis://localhost:6379"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="replace-me"
S3_SECRET_ACCESS_KEY="replace-me"
S3_BUCKET="postupai"

# Import safety
IMPORT_USER_AGENT="PostupaiDataBot/1.0 (+https://example.ru/methodology)"
IMPORT_RATE_LIMIT_MS="2000"

# AI providers remain disabled in Stage 1. Provider keys are server-side only.
AI_PROVIDER="disabled"
OPENAI_API_KEY=""

# Optional local-only admin created by `pnpm db:seed`.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
