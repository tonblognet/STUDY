# Only nonsecret rollout settings. Use a separate file and host for staging.
POSTUPAI_PROJECT_NAME=postupai-staging
POSTUPAI_MODE=staging
POSTUPAI_DOMAIN=staging.example.invalid
POSTUPAI_ENV_DIR=/etc/postupai/staging
POSTUPAI_WEB_IMAGE=
POSTUPAI_MIGRATE_IMAGE=
POSTUPAI_WORKER_IMAGE=
POSTUPAI_CADDY_IMAGE=
POSTUPAI_PUBLIC_TRAFFIC=false
POSTUPAI_ACCEPT_BANK_WEBHOOK=false
