{
  "name": "postupai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/test-integration.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern pages-dist --ignore-pattern .next --ignore-pattern outputs --ignore-pattern tmp",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "import:sample": "node scripts/import-official-csv.mjs data/sample-programs.csv",
    "data:discover": "tsx scripts/data-pipeline.ts discover",
    "data:fetch": "tsx scripts/data-pipeline.ts fetch",
    "data:parse": "tsx scripts/data-pipeline.ts parse",
    "data:validate": "tsx scripts/data-pipeline.ts validate",
    "data:import": "tsx scripts/data-pipeline.ts import",
    "data:report": "tsx scripts/data-pipeline.ts report",
    "security:audit": "pnpm audit --prod",
    "data:export": "tsx scripts/catalog.ts export",
    "data:diff": "tsx scripts/catalog.ts diff",
    "test:catalog:db": "tsx --test tests/catalog-db.test.ts"
  },
  "dependencies": {
    "@prisma/client": "6.18.0",
    "bcryptjs": "3.0.2",
    "jose": "6.1.0",
    "next": "16.3.3",
    "nodemailer": "9.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/nodemailer": "7.0.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "prettier": "3.6.2",
    "prisma": "6.18.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  },
  "type": "module"
}
