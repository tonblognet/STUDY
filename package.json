{
  "name": "postupai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern outputs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "import:sample": "node scripts/import-official-csv.mjs data/sample-programs.csv",
    "data:discover": "tsx scripts/data-pipeline.ts discover",
    "data:fetch": "tsx scripts/data-pipeline.ts fetch",
    "data:parse": "tsx scripts/data-pipeline.ts parse",
    "data:validate": "tsx scripts/data-pipeline.ts validate",
    "data:import": "tsx scripts/data-pipeline.ts import",
    "data:report": "tsx scripts/data-pipeline.ts report"
  },
  "dependencies": {
    "@prisma/client": "6.18.0",
    "bcryptjs": "3.0.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "prisma": "6.18.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "3.2.4",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
