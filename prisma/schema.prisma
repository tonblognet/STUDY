generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SUPPORT
  CONTENT_MANAGER
  ADMIN
  SUPERADMIN
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum EducationLevel {
  BACHELOR
  SPECIALIST
  MASTER
}

enum StudyForm {
  FULL_TIME
  PART_TIME
  EXTRAMURAL
}

enum PublicationStatus {
  DRAFT
  REVIEW
  PUBLISHED
  REJECTED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum SourceType {
  OFFICIAL_HTML
  OFFICIAL_PDF
  API
  CSV
  XLSX
  MANUAL
}

enum DataValueStatus {
  VERIFIED
  NOT_PUBLISHED
  PENDING_REVIEW
  OUTDATED
  CONFLICTING_SOURCES
  NOT_APPLICABLE
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  platformUserId         String?                 @unique
  emailVerified          DateTime?
  passwordHash           String?
  emailTwoFactorEnabled  Boolean                 @default(false)
  name                   String?
  role                   Role                    @default(USER)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  accounts               Account[]
  sessions               Session[]
  subscriptions          Subscription[]
  payments               Payment[]
  favorites              Favorite[]
  comparisons            Comparison[]
  notifications          Notification[]
  auditLogs              AuditLog[]              @relation("AuditActor")
  scoreProfiles          ScoreProfile[]
  passwordResetTokens    PasswordResetToken[]
  authChallenges         AuthChallenge[]
  applicantProfile       ApplicantProfile?
  trackerItems           AdmissionTrackerItem[]
  notificationPreference NotificationPreference?
  supportTickets         SupportTicket[]         @relation("TicketAuthor")
  assignedTickets        SupportTicket[]         @relation("TicketAssignee")
  ticketMessages         TicketMessage[]
  aiUsage                AiUsage[]
  stateSnapshot          UserStateSnapshot?
}

model UserStateSnapshot {
  userId    String   @id
  state     Json
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  userId        String
  expires       DateTime
  userAgentHash String?
  ipHash        String?
  lastSeenAt    DateTime  @default(now())
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expires])
}

model VerificationToken {
  identifier String
  tokenHash  String   @unique
  expires    DateTime

  @@unique([identifier, tokenHash])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expires   DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expires])
}

model AuthChallenge {
  id        String    @id @default(cuid())
  userId    String
  type      String
  tokenHash String    @unique
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String
  provider               String
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  productId              String?
  planCode               String
  status                 SubscriptionStatus
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?
  canceledAt             DateTime?
  autoRenew              Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments               Payment[]
  product                Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId, status])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  subscriptionId    String?
  productId         String
  providerPaymentId String?       @unique
  idempotencyKey    String        @unique
  amount            Int
  currency          String        @default("RUB")
  status            PaymentStatus
  description       String?
  paidAt            DateTime?
  refundedAt        DateTime?
  receiptUrl        String?
  providerStatus    String?
  createdAt         DateTime      @default(now())
  user              User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  product           Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

model Product {
  id            String               @id @default(cuid())
  code          String               @unique
  name          String
  description   String?
  price         Int
  currency      String               @default("RUB")
  durationDays  Int?
  displayOrder  Int                  @default(0)
  purchasable   Boolean              @default(true)
  active        Boolean              @default(true)
  features      Json
  limits        Json?
  subscriptions Subscription[]
  payments      Payment[]
  entitlements  ProductEntitlement[]

  @@index([active, purchasable, displayOrder])
}

model Entitlement {
  id       String               @id @default(cuid())
  key      String               @unique
  name     String
  products ProductEntitlement[]
}

model ProductEntitlement {
  productId     String
  entitlementId String
  limitValue    Int?
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  entitlement   Entitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  @@id([productId, entitlementId])
}

model University {
  id                String                @id @default(cuid())
  slug              String                @unique
  name              String
  shortName         String
  description       String?
  websiteUrl        String
  logoUrl           String?
  countryCode       String                @default("RU")
  regionCode        String?
  city              String
  address           String?
  latitude          Decimal?              @db.Decimal(9, 6)
  longitude         Decimal?              @db.Decimal(9, 6)
  contacts          Json?
  socialLinks       Json?
  hasDormitory      Boolean?
  dormitoryCount    Int?
  hasMilitaryCenter Boolean?
  license           Json?
  accreditation     Json?
  status            PublicationStatus     @default(REVIEW)
  updatedAt         DateTime              @updatedAt
  campuses          Campus[]
  programs          EducationProgram[]
  favorites         Favorite[]
  sources           DataSource[]
  factValues        UniversityFactValue[]

  @@index([status, name])
}

model Campus {
  id           String     @id @default(cuid())
  universityId String
  name         String
  address      String
  latitude     Decimal?   @db.Decimal(9, 6)
  longitude    Decimal?   @db.Decimal(9, 6)
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId])
}

model UniversityFactValue {
  id                  String                @id @default(cuid())
  universityId        String
  factKey             String
  year                Int
  value               Json?
  status              DataValueStatus
  sourceType          SourceType
  sourceUrl           String
  sourceName          String
  sourceDocumentTitle String?
  sourcePage          Int?
  sourceSheet         String?
  sourceRange         String?
  sourceSection       String?
  retrievedAt         DateTime
  checkedAt           DateTime
  checkedBy           String
  nextReviewAt        DateTime?
  note                String?
  version             Int                   @default(1)
  supersedesId        String?
  createdAt           DateTime              @default(now())
  university          University            @relation(fields: [universityId], references: [id], onDelete: Cascade)
  supersedes          UniversityFactValue?  @relation("UniversityFactHistory", fields: [supersedesId], references: [id], onDelete: SetNull)
  newerVersions       UniversityFactValue[] @relation("UniversityFactHistory")

  @@unique([universityId, factKey, year, version])
  @@index([universityId, year, factKey])
  @@index([status, checkedAt])
}

model EducationProgram {
  id              String                 @id @default(cuid())
  universityId    String
  slug            String                 @unique
  code            String
  name            String
  level           EducationLevel
  form            StudyForm
  durationMonths  Int?
  status          PublicationStatus      @default(REVIEW)
  publishedAt     DateTime?
  updatedAt       DateTime               @updatedAt
  university      University             @relation(fields: [universityId], references: [id], onDelete: Cascade)
  admissionYears  AdmissionYear[]
  favorites       Favorite[]
  comparisonItems ComparisonItem[]
  sources         DataSource[]
  metricValues    MetricValue[]
  trackerItems    AdmissionTrackerItem[]

  // A specialty code can contain several distinct faculties/profiles/contest groups.
  // The stable publication slug identifies the concrete program.
  @@index([universityId, code, level, form])
  @@index([status, level, form])
  @@index([name])
}

model AdmissionYear {
  id            String                @id @default(cuid())
  programId     String
  year          Int
  program       EducationProgram      @relation(fields: [programId], references: [id], onDelete: Cascade)
  plans         AdmissionPlan[]
  requirements  EntranceRequirement[]
  prices        TuitionPrice[]
  passingScores PassingScore[]

  @@unique([programId, year])
  @@index([year])
}

model AdmissionPlan {
  id              String        @id @default(cuid())
  admissionYearId String        @unique
  budgetPlaces    Int?
  paidPlaces      Int?
  targetPlaces    Int?
  admissionYear   AdmissionYear @relation(fields: [admissionYearId], references: [id], onDelete: Cascade)
}

model ExamSubject {
  id           String                @id @default(cuid())
  slug         String                @unique
  name         String
  requirements EntranceRequirement[]
  scores       ExamScore[]
}

model EntranceRequirement {
  id                String          @id @default(cuid())
  admissionYearId   String
  subjectId         String
  minScore          Int?
  priority          Int
  required          Boolean         @default(true)
  alternativesGroup String          @default("required")
  admissionYear     AdmissionYear   @relation(fields: [admissionYearId], references: [id], onDelete: Cascade)
  subject           ExamSubject     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  additionalExam    AdditionalExam?

  @@unique([admissionYearId, subjectId, alternativesGroup])
  @@index([subjectId, minScore])
}

model AdditionalExam {
  id                    String              @id @default(cuid())
  entranceRequirementId String              @unique
  name                  String
  format                String?
  minScore              Int?
  maxScore              Int?
  details               String?
  entranceRequirement   EntranceRequirement @relation(fields: [entranceRequirementId], references: [id], onDelete: Cascade)
}

model TuitionPrice {
  id              String        @id @default(cuid())
  admissionYearId String
  amount          Int
  currency        String        @default("RUB")
  period          String        @default("YEAR")
  admissionYear   AdmissionYear @relation(fields: [admissionYearId], references: [id], onDelete: Cascade)

  @@unique([admissionYearId, period])
}

model PassingScore {
  id              String        @id @default(cuid())
  admissionYearId String
  competitionType String        @default("GENERAL")
  score           Decimal?      @db.Decimal(6, 2)
  status          String        @default("CONFIRMED")
  admissionYear   AdmissionYear @relation(fields: [admissionYearId], references: [id], onDelete: Cascade)

  @@unique([admissionYearId, competitionType])
}

model DataSource {
  id            String            @id @default(cuid())
  universityId  String?
  programId     String?
  type          SourceType
  title         String
  url           String
  checksum      String?
  lastCheckedAt DateTime?
  robotsAllowed Boolean           @default(true)
  active        Boolean           @default(true)
  publishedAt   DateTime?
  retrievedAt   DateTime?
  reliability   Decimal?          @db.Decimal(3, 2)
  parserVersion String?
  university    University?       @relation(fields: [universityId], references: [id], onDelete: Cascade)
  program       EducationProgram? @relation(fields: [programId], references: [id], onDelete: Cascade)
  parsingJobs   ParsingJob[]
  artifacts     SourceArtifact[]

  @@index([active, lastCheckedAt])
}

model SourceArtifact {
  id             String        @id @default(cuid())
  sourceId       String
  url            String
  documentTitle  String?
  mimeType       String
  checksumSha256 String
  localCachePath String?
  httpHeaders    Json?
  retrievedAt    DateTime
  year           Int?
  category       String?
  source         DataSource    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  metricValues   MetricValue[]

  @@unique([url, checksumSha256])
  @@index([sourceId, retrievedAt])
}

model MetricValue {
  id                  String           @id @default(cuid())
  programId           String
  artifactId          String?
  metricKey           String
  competitionType     String?
  year                Int
  value               Json?
  status              DataValueStatus
  sourceUrl           String
  sourceName          String
  sourceDocumentTitle String?
  sourcePage          Int?
  sourceSheet         String?
  sourceRange         String?
  sourceSection       String?
  retrievedAt         DateTime
  checkedAt           DateTime
  checkedBy           String
  nextReviewAt        DateTime?
  note                String?
  version             Int              @default(1)
  supersedesId        String?
  createdAt           DateTime         @default(now())
  program             EducationProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  artifact            SourceArtifact?  @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  supersedes          MetricValue?     @relation("MetricHistory", fields: [supersedesId], references: [id], onDelete: SetNull)
  newerVersions       MetricValue[]    @relation("MetricHistory")

  @@unique([programId, metricKey, year, competitionType, version])
  @@index([programId, year, metricKey])
  @@index([status, checkedAt])
}

model ScoreProfile {
  id                     String      @id @default(cuid())
  userId                 String
  name                   String
  individualAchievements Int         @default(0)
  dviScore               Int?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  user                   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scores                 ExamScore[]

  @@index([userId, updatedAt])
}

model ExamScore {
  profileId String
  subjectId String
  score     Int
  profile   ScoreProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  subject   ExamSubject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([profileId, subjectId])
}

model ParsingJob {
  id           String         @id @default(cuid())
  sourceId     String
  status       JobStatus      @default(QUEUED)
  startedAt    DateTime?
  finishedAt   DateTime?
  itemsFound   Int            @default(0)
  itemsChanged Int            @default(0)
  log          Json?
  source       DataSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  errors       ParsingError[]

  @@index([status, startedAt])
}

model ParsingError {
  id        String     @id @default(cuid())
  jobId     String
  code      String
  message   String
  url       String?
  context   Json?
  createdAt DateTime   @default(now())
  job       ParsingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

model Favorite {
  id           String            @id @default(cuid())
  userId       String
  universityId String?
  programId    String?
  createdAt    DateTime          @default(now())
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  university   University?       @relation(fields: [universityId], references: [id], onDelete: Cascade)
  program      EducationProgram? @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, universityId, programId])
  @@index([userId, createdAt])
}

model Comparison {
  id        String           @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ComparisonItem[]

  @@index([userId, updatedAt])
}

model ComparisonItem {
  comparisonId String
  programId    String
  position     Int
  comparison   Comparison       @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  program      EducationProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@id([comparisonId, programId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model NotificationPreference {
  id                  String  @id @default(cuid())
  userId              String  @unique
  emailEnabled        Boolean @default(true)
  inAppEnabled        Boolean @default(true)
  deadlines           Boolean @default(true)
  competitionPosition Boolean @default(true)
  programChanges      Boolean @default(true)
  payments            Boolean @default(true)
  subscriptions       Boolean @default(true)
  security            Boolean @default(true)
  productNews         Boolean @default(false)
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApplicantProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  admissionYear          Int
  homeCity               String?
  desiredCities          String[]
  interests              String[]
  desiredCareers         String[]
  olympiads              Json?
  hasBvi                 Boolean  @default(false)
  benefits               Json?
  quotas                 Json?
  individualAchievements Int      @default(0)
  tuitionBudget          Int?
  preferredStudyForms    String[]
  constraints            Json?
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdmissionTrackerItem {
  id              String           @id @default(cuid())
  userId          String
  programId       String
  admissionYear   Int
  priority        Int?
  status          String
  stage           String
  currentPosition Int?
  deadlineAt      DateTime?
  notes           String?
  documents       Json?
  history         Json
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  program         EducationProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, programId, admissionYear])
  @@index([userId, deadlineAt])
}

model SupportTicket {
  id         String          @id @default(cuid())
  userId     String
  assigneeId String?
  subject    String
  category   String
  status     String          @default("OPEN")
  priority   String          @default("NORMAL")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  user       User            @relation("TicketAuthor", fields: [userId], references: [id], onDelete: Cascade)
  assignee   User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages   TicketMessage[]

  @@index([status, priority, updatedAt])
  @@index([userId, updatedAt])
}

model TicketMessage {
  id          String        @id @default(cuid())
  ticketId    String
  authorId    String
  body        String
  attachments Json?
  createdAt   DateTime      @default(now())
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

model AiUsage {
  id            String   @id @default(cuid())
  userId        String?
  feature       String
  provider      String
  model         String
  usageMetadata Json?
  costMinor     Int?
  chargedUnits  Int      @default(0)
  resultStatus  String
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, feature, createdAt])
}

enum CatalogRevisionStatus {
  REVIEW
  PUBLISHED
  REJECTED
}

model CatalogRevision {
  id             String                @id @default(cuid())
  fingerprint    String                @unique
  checksum       String
  baseRevisionId String?
  status         CatalogRevisionStatus @default(REVIEW)
  payload        Json
  changes        Json
  reason         String
  createdBy      String
  createdAt      DateTime              @default(now())
  reviewedBy     String?
  reviewNote     String?
  reviewedAt     DateTime?
  head           CatalogHead?

  @@index([status, createdAt])
}

model CatalogHead {
  id         String           @id @default("public")
  revisionId String?          @unique
  revision   CatalogRevision? @relation(fields: [revisionId], references: [id], onDelete: Restrict)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipHash     String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
